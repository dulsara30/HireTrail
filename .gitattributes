# Set default line endings to LF for cross-platform consistency
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Executable scripts and binaries
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg text eol=lf
