# Environment & Server
APP_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/hiretrail_dev?replicaSet=rs0
MONGODB_DB_NAME=hiretrail_dev

# Web App & CORS
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Authentication & Security
JWT_ACCESS_SECRET=hiretrail-dev-jwt-access-secret-minimum-32-characters-long
JWT_ISSUER=hiretrail-api
JWT_AUDIENCE=hiretrail-web
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=hiretrail-dev-cookie-secret-minimum-32-characters-long
IP_HASH_SALT=hiretrail-dev-ip-salt-16-bytes

# Google OAuth
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Gemini AI (Free Tier)
GEMINI_API_KEY=mock-gemini-api-key
GEMINI_MODEL_EXTRACT=gemini-3.5-flash-lite
GEMINI_MODEL_GROUNDED=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.8-flash
# Models tried in order for Google Search calls (company lookup, accuracy check)
GEMINI_MODEL_GROUNDED_FALLBACK=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview
# Web search that finds real public pages about a company (company lookup and accuracy check).
# Free key: sign up at https://app.tavily.com (no card), copy the key that starts with tvly-
TAVILY_API_KEY=
# Stop using search after this many credits in a month (the free plan has about 1000)
TAVILY_MONTHLY_BUDGET=900
# When search finds nothing, try the company's own website (guessed from its name)
LOOKUP_WEBSITE_GUESS=true
GEMINI_TOOLS_WITH_SCHEMA=false
AI_ENABLED=true
AI_GLOBAL_DAILY_LIMIT=500
AI_QUOTA_AUTOFILL=40
AI_QUOTA_COMPANY_VERIFY=20
AI_QUOTA_COMPANY_LOOKUP=20
AI_QUOTA_INSIGHTS=1
# Orbit quick add: the AI refine button (PRO), tiny requests
AI_QUOTA_ORBIT_PARSE=40

# Email Service
# Email through Resend (https://resend.com). Used for sign-up emails and the Orbit reminder and morning emails.
# Get the key: Resend dashboard > API Keys > Create API Key (it starts with re_). Put it here and in the Vercel API project.
# Without a real key (or in development) emails are only printed in the API console.
EMAIL_API_KEY=re_your_resend_api_key
# The sender. In Resend, verify your own domain (Domains > Add Domain) and use an address on it,
# for example HireTrail <no-reply@yourdomain.com>. Until a domain is verified Resend only allows its test sender.
EMAIL_FROM=HireTrail <no-reply@hiretrail.local>

# Secret that lets a scheduler call the Orbit email jobs (daily morning summary and due reminders).
# Make a long random value, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in the Vercel API project: Vercel sends it to the cron job as "Authorization: Bearer <value>".
# Leave it empty to turn the jobs off.
CRON_SECRET=

# Optional Observability
SENTRY_DSN=
