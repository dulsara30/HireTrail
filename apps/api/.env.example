# Environment & Server
APP_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/hiretrail_dev?replicaSet=rs0
MONGODB_DB_NAME=hiretrail_dev

# Web App & CORS
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Authentication & Security
JWT_ACCESS_SECRET=hiretrail-dev-jwt-access-secret-minimum-32-characters-long
JWT_ISSUER=hiretrail-api
JWT_AUDIENCE=hiretrail-web
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=hiretrail-dev-cookie-secret-minimum-32-characters-long
IP_HASH_SALT=hiretrail-dev-ip-salt-16-bytes

# Google OAuth
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Gemini AI (Free Tier)
GEMINI_API_KEY=mock-gemini-api-key
GEMINI_MODEL_EXTRACT=gemini-3.1-flash-lite
GEMINI_MODEL_GROUNDED=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-latest
GEMINI_TOOLS_WITH_SCHEMA=false
AI_ENABLED=true
AI_GLOBAL_DAILY_LIMIT=500
AI_QUOTA_AUTOFILL=40
AI_QUOTA_COMPANY_VERIFY=20
AI_QUOTA_COMPANY_LOOKUP=20
AI_QUOTA_INSIGHTS=1

# Email Service
EMAIL_API_KEY=mock-email-api-key
EMAIL_FROM=HireTrail <no-reply@hiretrail.local>

# Optional Observability
SENTRY_DSN=
