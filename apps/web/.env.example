# API origin for server-side rewrites
API_ORIGIN=http://localhost:4000

# Public application variables
NEXT_PUBLIC_APP_NAME=HireTrail
NEXT_PUBLIC_SENTRY_DSN=

# Google Drive resume picker (public values; restrict the API key to your domains and the Picker/Drive APIs)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Google Cloud project number (the first part of the client ID)
NEXT_PUBLIC_GOOGLE_APP_ID=
